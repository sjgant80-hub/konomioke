stateDiagram-v2
  [*] --> init

  state "ENGINE BOOT" as engine_boot {
    init --> load_templates : boot-loader.js
    load_templates --> load_phases : 5 html templates
    load_phases --> p2_identity : globals → identity
    p2_identity --> p3_mesh : Ed25519 + IndexedDB
    p3_mesh --> p5_fabric : WebRTC mesh
    p5_fabric --> p7_vocal : AudioContext + FFT
    p7_vocal --> p11_tracks : pitch + harmony
    p11_tracks --> p13_viz : CRDT queue + LRC
    p13_viz --> p17_rooms : Three.js orb
    p17_rooms --> p17_chat : room-manager
    p17_chat --> p17_app : chat-history
    p17_app --> p17_boot : UI bindings
    p17_boot --> arm_start : gh-config + KCC mining
  }

  arm_start --> tap_to_start : "tap anywhere"
  tap_to_start --> auto_enter : pointerdown/keydown

  state "AUTO ENTER" as auto_enter {
    [*] --> fabric_resume
    fabric_resume --> fetch_rooms : fetchRoomTags (3s max)
    fetch_rooms --> pick_room

    state pick_room <<choice>>
    pick_room --> join_konomi : room has space
    pick_room --> create_overflow : all full (FIFO)

    join_konomi --> enter_stage
    create_overflow --> enter_stage
  }

  state "ROOM SYSTEM" as rooms {
    state "KONOMI" as r1 : max 8 users
    state "KONOMI-2" as r2 : overflow
    r1 --> r2 : 8/8 full
  }

  auto_enter --> stage

  state "STAGE" as stage {
    [*] --> render_loop

    state "RENDER (60Hz)" as render_loop {
      [*] --> analyze_voice
      analyze_voice --> update_charge
      update_charge --> update_blasts
      update_blasts --> update_vfx
      update_vfx --> animate_sprites
      animate_sprites --> render_scene
      render_scene --> analyze_voice
    }

    state "VOICE" as voice_pipe {
      mic_input --> fft_analyze : getUserMedia
      fft_analyze --> f0_detect : autocorrelation
      f0_detect --> vowel_classify : formant peaks
      vowel_classify --> phoneme_map : ah=火 ee=雷 oh=気 oo=水 eh=風 mm=土
    }

    state "BLAST" as blast_pipe {
      phoneme_map --> charge : hold vowel
      charge --> fire : release
      fire --> projectile : Three.js sphere + kanji
      projectile --> hit_target : collision
      hit_target --> score : damage + combo
      hit_target --> explosion : 12 particles
    }

    state "P2P NET" as net {
      state "LOCAL" as local : BroadcastChannel
      state "GLOBAL" as global : MQTT wss://hivemq
      local --> peer_join : same browser
      global --> peer_join : cross device
      peer_join --> spawn_sprite : createSprite(id)
      peer_join --> chat_msg : addMsg
    }
  }

  stage --> lobby : leave
  stage --> cleanup : tab close

  state "CLEANUP" as cleanup {
    [*] --> leave_room : leaveDefaultRoom
    leave_room --> mqtt_disconnect
    mqtt_disconnect --> bc_leave : pollSignalLeave
    bc_leave --> [*]
  }

  state "CHAT PANEL" as chat_panel {
    state "MSG" as tab_msg : user messages
    state "LOG" as tab_log : trace() entries
    state "ERR" as tab_err : console.error capture
    state "SM" as tab_sm : state transitions
  }

  state "TAG.DB" as tagdb {
    state "konomi-config" as kc {
      _platform --> _state_machine
      _phases --> _rings
      _theme --> _mining
      _audio --> _viz
      _mesh --> _identity
      _tracks --> _emojis
      _views --> _rooms
      _chat --> _errors
      _arena --> _sprites
    }
    state "engine-config" as ec {
      _settings : pitch harmony drones viz aec noiseGate selfMonitor
    }
  }

  cleanup --> [*]

  note right of net
    BroadcastChannel: instant same-origin
    MQTT: wss://broker.hivemq.com:8884
    Topic: konomi/chat/KONOMI/*
    join/leave/chat/blast/score
  end note

  note right of rooms
    Tracked via GH Issue #14
    Max 8 users per room
    FIFO overflow naming
    Empty rooms auto-pruned
  end note
